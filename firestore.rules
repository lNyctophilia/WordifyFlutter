rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return request.auth != null && role in getUserData().roles;
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isAdmin() {
      return isOwner() || hasRole('admin');
    }

    match /users/{userId} {
      // Kullanıcı kendi profilini, yönetici/admin herkesi okuyabilir
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // İlk kayıt: kullanıcı kendi uid'si ile 'staff' rolünde kayıt açabilir
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.isApproved == false &&
        request.resource.data.roles.size() == 1 &&
        request.resource.data.roles[0] == 'staff';

      // Güncelleme: Admin herkesi, kullanıcı ise sadece kendi oturum ve profil bilgilerini güncelleyebilir
      allow update: if request.auth != null && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastLoginAt', 'displayName', 'photoURL', 'fcmToken', 'sessionId'
          ])
        )
      );

      // Sadece admin silebilir
      allow delete: if request.auth != null && isAdmin();
    }

    // Wordify genel sistem ayarları
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
